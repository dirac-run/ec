#!/usr/bin/env python3
"""Install the local build without replacing another application's command."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import tempfile


def digest(path):
    with path.open('rb') as handle:
        return hashlib.file_digest(handle, 'sha256').hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path, default=Path(__file__).resolve().parents[1] / 'build/ec')
    parser.add_argument('--prefix', type=Path, default=Path.home() / '.local')
    parser.add_argument('--name', choices=['ec', 'easycommand'], default='ec')
    args = parser.parse_args()
    source = args.binary.resolve(strict=True)
    if not source.is_file() or not os.access(source, os.X_OK):
        parser.error('the source must be an executable file; build the application first')
    prefix = args.prefix.expanduser().resolve()
    destination = prefix / 'bin' / args.name
    receipt = prefix / 'share/easycommand' / (args.name + '-install.json')
    previous = json.loads(receipt.read_text()) if receipt.is_file() else {}
    owned = destination.is_file() and not destination.is_symlink() and previous.get('sha256') == digest(destination)
    if os.path.lexists(destination) and not owned:
        parser.error(f'{destination} already exists and is not our recorded installation; use another --prefix or --name')
    on_path = shutil.which(args.name)
    if on_path and Path(on_path).absolute() != destination:
        parser.error(f'{args.name} already resolves to {on_path}; use --name easycommand or another name/prefix arrangement')
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False, prefix='.ec-install-') as handle:
        pending = Path(handle.name)
    try:
        shutil.copyfile(source, pending)
        pending.chmod(0o755)
        pending.replace(destination)
    finally:
        pending.unlink(missing_ok=True)
    receipt.parent.mkdir(parents=True, exist_ok=True)
    receipt.write_text(json.dumps({'sha256': digest(destination)}, indent=2) + '\n')
    package = Path(__file__).resolve().parents[1]
    notices = prefix / 'share/licenses/easycommand'
    notices.mkdir(parents=True, exist_ok=True)
    for name in ('LICENSE', 'THIRD_PARTY.md'):
        shutil.copyfile(package / name, notices / name)
    shutil.copytree(package / 'licenses', notices, dirs_exist_ok=True)
    print(f'Installed {destination}')
    print(f'Add {destination.parent} to PATH if it is not already there.')


if __name__ == '__main__':
    main()
